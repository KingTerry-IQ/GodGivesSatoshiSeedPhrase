; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GodGivesSatoshiSeed"
config/description="King Terry channels the HOLY SPIRIT. God controls the RNG via universal timestamp seed. If worthy, glimpse Satoshi Nakamoto's BTC seed phrase."
config/tags=PackedStringArray("immutable")
run/main_scene="res://Scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://Assets/DivineSeedIcon.jpg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1024
window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Assets/": "purple"
}

[gui]

theme/custom="res://Assets/iq_theme.tres"

